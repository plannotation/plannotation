{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plannotation.github.io/schema/0.1/plannotation.schema.json",
  "title": "Plannotation 0.1",
  "description": "Machine-readable semantics for one 2D construction-drawing page. The page is the leading document; the label is auxiliary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plannotation",
    "provenance",
    "page",
    "sheet"
  ],
  "properties": {
    "plannotation": {
      "const": "0.1"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "widthMm",
        "heightMm"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based PDF page index"
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ],
          "default": 0
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "sheet number as printed, e.g. TWP-101"
        },
        "title": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "documentId": {
          "type": "string",
          "description": "ISO 19650 / DIN container ID if used"
        },
        "discipline": {
          "type": "string",
          "enum": [
            "architecture",
            "structure",
            "mep",
            "civil",
            "landscape",
            "other"
          ]
        },
        "drawingType": {
          "type": "string",
          "enum": [
            "plan",
            "section",
            "elevation",
            "detail",
            "schedule",
            "positionsplan",
            "schalplan",
            "bewehrungsplan",
            "lageplan",
            "other"
          ]
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "denominator: 50 means 1:50; viewport scales override"
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "number": {
              "type": "string"
            }
          }
        },
        "author": {
          "type": "string"
        },
        "checker": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "titleBlockBBox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "type": "string",
          "examples": [
            "IFC4",
            "IFC4X3_ADD2"
          ]
        },
        "lengthUnit": {
          "type": "string",
          "enum": [
            "m",
            "mm",
            "cm"
          ]
        }
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/viewport"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-"
      },
      "description": "namespaced extras; never required by readers"
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": [
        "authored",
        "inferred",
        "mixed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "ifcGuid": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_$]{22}$"
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "polyline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 2
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x0, y0, x1, y1] paper mm, origin bottom-left, y up"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "paperBBox"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "plan",
            "section",
            "elevation",
            "detail",
            "3d",
            "schedule",
            "legend",
            "titleblock"
          ]
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "paperBBox": {
          "$ref": "#/$defs/bbox"
        },
        "plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "xAxis",
            "yAxis"
          ],
          "properties": {
            "origin": {
              "$ref": "#/$defs/vec3"
            },
            "xAxis": {
              "$ref": "#/$defs/vec3"
            },
            "yAxis": {
              "$ref": "#/$defs/vec3"
            }
          },
          "description": "model-space plane of the view; view direction = xAxis x yAxis"
        },
        "paperToPlane": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6,
          "description": "affine [a,b,c,d,e,f]: X=a*x+c*y+e, Y=b*x+d*y+f; paper mm -> plane coords in model length unit"
        },
        "cutHeight": {
          "type": "number"
        },
        "storey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ifcGuid": {
              "$ref": "#/$defs/ifcGuid"
            },
            "name": {
              "type": "string"
            },
            "elevation": {
              "type": "number"
            }
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ifcClass",
        "paperBBox"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "ifcGuid": {
          "$ref": "#/$defs/ifcGuid"
        },
        "ifcClass": {
          "type": "string",
          "pattern": "^Ifc[A-Za-z0-9]+$"
        },
        "predefinedType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "description": "mark as printed, e.g. 'Pos. 12'"
        },
        "viewport": {
          "$ref": "#/$defs/localId"
        },
        "paperBBox": {
          "$ref": "#/$defs/bbox"
        },
        "paperOutlines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polyline"
          }
        },
        "representation": {
          "type": "string",
          "enum": [
            "cut",
            "projection",
            "hidden",
            "symbol"
          ]
        },
        "properties": {
          "type": "object",
          "description": "PsetName -> { property: value }"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "paperBBox"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "type": {
          "type": "string",
          "enum": [
            "dimension",
            "tag",
            "text",
            "callout",
            "sectionMark",
            "grid",
            "level",
            "revisionCloud",
            "keynote",
            "symbol",
            "leader",
            "hatch",
            "northArrow",
            "scaleBar"
          ]
        },
        "viewport": {
          "$ref": "#/$defs/localId"
        },
        "paperBBox": {
          "$ref": "#/$defs/bbox"
        },
        "text": {
          "type": "string",
          "description": "exactly as printed"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "mm",
            "cm",
            "m",
            "deg",
            "pct"
          ]
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "description": "element or grid ids a dimension runs between"
        },
        "geometry": {
          "$ref": "#/$defs/polyline",
          "description": "dimension line / leader, paper mm"
        },
        "shows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "element": {
              "$ref": "#/$defs/localId"
            },
            "property": {
              "type": "string",
              "examples": [
                "Tag",
                "Pset_BeamCommon.Span"
              ]
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sheetId": {
              "type": "string"
            },
            "viewportId": {
              "$ref": "#/$defs/localId"
            },
            "detail": {
              "type": "string"
            },
            "pdfPage": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "axis": {
          "type": "string",
          "description": "grid label, e.g. 'B'"
        },
        "elevation": {
          "type": "number"
        },
        "ifcGuid": {
          "$ref": "#/$defs/ifcGuid"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
